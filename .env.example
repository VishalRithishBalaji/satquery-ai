APP_NAME=SatQuery AI
APP_ENV=development
APP_VERSION=0.2.0
DEBUG=true
HOST=127.0.0.1
PORT=8000

HF_TOKEN=
MODEL_ID=tugrulkaya/GeoQwen-VL-2B-EuroSAT
BASE_MODEL_ID=Qwen/Qwen2-VL-2B-Instruct

MODEL_DIR=./models
CHECKPOINT_DIR=./models/checkpoints
DATASET_DIR=./datasets
REPORT_DIR=./reports
LOG_DIR=./backend/logs
OUTPUT_DIR=./datasets/outputs

AGENT_FRAMEWORK=langgraph
ENABLE_AGENT_TRACE=true
ENABLE_CONFIDENCE_SCORING=true
ENABLE_UNCERTAINTY_ESCALATION=true
UNCERTAINTY_THRESHOLD=0.55

FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=200
ALLOWED_EXTENSIONS=.tif,.tiff,.png,.jpg,.jpeg
MAX_IMAGE_SIDE=1536
MODEL_MAX_PIXELS=401408
MAX_NEW_TOKENS=128
TEMPERATURE=0.15
LOG_LEVEL=INFO
